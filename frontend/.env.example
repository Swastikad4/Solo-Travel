# ====================================================================
# SoloTravel India — Frontend Environment Configuration
# Copy this file to .env for local development
# Set these in the Vercel / Netlify dashboard for production
# ====================================================================

# 1. Backend REST API URL (Default local: http://localhost:5000)
REACT_APP_API_URL=http://localhost:5000

# 2. Real-Time Socket.IO Server URL (Leave blank to reuse REACT_APP_API_URL)
REACT_APP_SOCKET_URL=http://localhost:5000
